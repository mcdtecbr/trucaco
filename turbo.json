{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["src/**", "app/**", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["src/**", "app/**", "tsconfig*.json", "package.json"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["src/**", "app/**", "tsconfig*.json", "package.json"]
    },
    "lint": {
      "inputs": ["src/**", "app/**", "../../eslint.config.mjs", "package.json"],
      "dependsOn": ["db:generate"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts", "package.json"],
      "outputs": ["src/generated/**"]
    }
  }
}
