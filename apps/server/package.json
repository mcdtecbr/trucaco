{
  "name": "@trucaco/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts --dev",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@colyseus/core": "0.18.10",
    "@colyseus/schema": "5.0.43",
    "@colyseus/ws-transport": "0.18.4",
    "@trucaco/protocol": "workspace:*",
    "@trucaco/rules": "workspace:*",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@colyseus/testing": "0.18.6",
    "@types/express": "5.0.6",
    "tsup": "9.0.0",
    "tsx": "4.23.15"
  }
}
