{
  "name": "@trucaco/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web",
    "start": "expo start",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
