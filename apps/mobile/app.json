{
  "expo": {
    "name": "Trucaco",
    "slug": "trucaco",
    "version": "0.0.0",
    "scheme": "trucaco",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.mcdtec.trucaco",
      "supportsTablet": true
    },
    "android": {
      "package": "com.mcdtec.trucaco"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
