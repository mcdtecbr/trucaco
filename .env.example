# Copie para .env e ajuste. Valores abaixo são só para desenvolvimento local.
# Nunca versione o .env nem coloque segredos reais neste arquivo.

# Postgres (infra/docker-compose.yml)
POSTGRES_USER=trucaco
POSTGRES_PASSWORD=trucaco_dev_only
POSTGRES_DB=trucaco
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trucaco:trucaco_dev_only@localhost:5432/trucaco
# Banco DESCARTÁVEL do `pnpm test:int` (TRUNCATE ... CASCADE). Host local e nome com "test" ou "verif";
# qualquer outro valor é recusado antes de escrever. Migre-o com DATABASE_URL apontando para ele.
TEST_DATABASE_URL=postgresql://trucaco:trucaco_dev_only@localhost:5432/trucaco_test

# Redis (infra/docker-compose.yml)
# 6380 no host para não colidir com outro Redis local na 6379
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Servidor
PORT=2567
# Segredo HS256 do JWT de acesso: OBRIGATÓRIO, mínimo 32 bytes, sem valor padrão. Fora de
# NODE_ENV=development|test o servidor recusa subir sem ele (e recusa este valor de exemplo).
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-em-producao
JWT_ISSUER=trucaco
JWT_AUDIENCE=trucaco-api
# Access token (segundos, 60 a 3600) e refresh token opaco rotativo (3600 a 7776000)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Janela de graça (0 a 60 s): reapresentar o refresh recém-rotacionado (resposta perdida, duas abas)
# não revoga a família; emite um sucessor irmão, uma única vez. 0 desliga.
REFRESH_REUSE_GRACE_SECONDS=20
# Teto absoluto de vida de uma família de refresh desde a criação (3600 a 31536000 s): a rotação não renova além dele.
REFRESH_FAMILY_MAX_SECONDS=7776000
# Origens CORS permitidas, separadas por vírgula (origem exata, sem "*"). Vazio = nenhuma.
# Para o Expo web em dev (apps/mobile) use a origem do dev server:
# CORS_ORIGINS=http://localhost:8081
CORS_ORIGINS=
# SOMENTE dev/test (E2E determinístico): semente fixa do baralho (inteiro 0..4294967295). Com
# NODE_ENV=development|test todas as mesas usam esta semente (mesmo baralho); em qualquer outro
# ambiente é IGNORADA (o servidor registra um aviso, sem o valor). Deixe vazio fora de dev/test.
# TRUCO_SEED=42
# SOMENTE dev/test (E2E): =1 desliga o anti-farm da progressão (mínimo de mãos e duração, tetos por par e
# por usuário, mesa privada só de convidados) para que partidas rápidas pontuem. Fora de
# NODE_ENV=development|test o servidor RECUSA subir com ela. Deixe vazio fora de dev/test.
# TRUCO_PROGRESSION_RELAXED=1
# Rate limit REST (padrões): convidados por IP/hora, teto global de convidados/hora,
# /auth/refresh por IP/min, qualquer rota por IP/min e rotas autenticadas por usuário/min.
AUTH_GUEST_PER_IP_PER_HOUR=10
AUTH_GUEST_GLOBAL_PER_HOUR=2000
AUTH_REFRESH_PER_IP_PER_MIN=30
REST_PER_IP_PER_MIN=120
REST_PER_USER_PER_MIN=60
# POST /auth/google|apple|link por IP/min. Padrão 20.
AUTH_SOCIAL_PER_IP_PER_MIN=20
# Login social (Fase 6F). Client IDs aceitos no `aud` do idToken, separados por vírgula. VAZIO = provedor
# desligado (SOCIAL_LOGIN_DISABLED). Ids públicos, não são segredo; vêm do Google Cloud e do Apple Developer.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# SOMENTE dev/test: AUTH_TEST_IDENTITY=1 aceita idToken `test:<sub>[:<sufixo>]` (E2E sem Google/Apple).
# Com NODE_ENV diferente de development/test o servidor RECUSA subir. Deixe vazio fora de dev/test.
AUTH_TEST_IDENTITY=
# Redis DESCARTÁVEL do `pnpm test:int` (apaga chaves trucaco:v1:*). Host local e DB lógico != 0.
TEST_REDIS_URL=redis://localhost:6380/15
# Limite de criar/entrar em mesa por IP (POST /matchmake/*), por minuto. Padrão 20.
MATCHMAKE_RATE_LIMIT_PER_MIN=20
# Proxy confiável (IP real para rate limit). `false` (padrão); `true` só se TODO tráfego passa por proxy que
# define X-Forwarded-For (usa o último item); ou o NOME do cabeçalho que o proxy define sozinho. Na Fly.io:
# TRUST_PROXY=Fly-Client-IP (o cliente não consegue forjá-lo se todo tráfego passa pelo proxy da Fly).
TRUST_PROXY=false
# GET /auth/nonce (nonce do login social) por IP/min. Padrão 30.
AUTH_NONCE_PER_IP_PER_MIN=30
# GET /auth/nonce no servidor inteiro por minuto (teto contra enchente com muitos IPs). Padrão 300.
AUTH_NONCE_GLOBAL_PER_MIN=300
# Web na mesma origem: pasta do export do Expo web (com index.html). Vazio = só API.
# O servidor serve os arquivos e cai no index.html nas rotas de página. Ex.: apps/mobile/dist
WEB_DIST_DIR=
# GET /metrics (JSON interno: salas, assentos, fila, reconexões, erros por código; sem PII). Só existe com
# token: vazio = rota desligada (404). Mínimo 32 caracteres (`openssl rand -base64 48`); uso: Authorization: Bearer.
# Nunca exponha esta rota publicamente sem o token (Fly: só rede interna ou com o token).
METRICS_TOKEN=
# Retenção diária de dados (deals 30 d, partidas canceladas 30 d, partidas 12 meses, convidados inativos
# 90 d, missões 90 d; docs/banco-de-dados.md). `true` liga (precisa de DATABASE_URL); vazio/false desliga.
RETENTION_ENABLED=
# Lobby (mesas privadas e fila pública), valores em segundos. Padrões entre parênteses.
# Validade de uma entrada na fila pública (120) e prazo para os 4 sentarem depois da mesa formada (45).
LOBBY_QUEUE_TTL_SECONDS=120
LOBBY_FILL_SECONDS=45
# Entrar por código: tentativas/min por usuário (10) e por IP (30); falhas que bloqueiam o usuário (6)
# e duração do bloqueio em segundos (600). Em memória, por processo.
JOIN_ATTEMPTS_PER_USER_PER_MIN=10
JOIN_ATTEMPTS_PER_IP_PER_MIN=30
JOIN_FAIL_LOCK_THRESHOLD=6
JOIN_LOCK_SECONDS=600
# Fila pública: quem casa e não senta (ou desiste/sai da mesa em espera) fica este tempo sem reentrar (60; 0 desliga).
QUEUE_REENTRY_COOLDOWN_SECONDS=60
# Piso de latência (ms) das recusas de POST /tables/join, contra oráculo de tempo (150; 0 desliga).
JOIN_MIN_LATENCY_MS=150
# Força bruta distribuída: falhas por prefixo IPv6 /48 (60) e do servidor inteiro (1000) em 10 min.
JOIN_FAILS_PER_IPV6_48=60
JOIN_FAILS_GLOBAL=1000

# Cliente Expo (apps/mobile): URL do servidor, vai para o bundle (sem segredo).
EXPO_PUBLIC_SERVER_URL=http://localhost:2567
# Cliente Expo: 1 liga a sonda de estado da mesa usada nos testes E2E (deixe vazio fora deles).
EXPO_PUBLIC_E2E=
