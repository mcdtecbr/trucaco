# Build a partir da raiz do repositório:
#   docker build -f infra/Dockerfile.server -t trucaco-server .
ARG NODE_IMAGE=node:22.12.0-alpine3.21

# Os package.json dos demais workspaces entram só para o lockfile casar com --frozen-lockfile.
# ---- build: instala tudo, gera o Prisma Client e apps/server/dist/main.js (bundle tsup) ----
FROM ${NODE_IMAGE} AS build
ENV CI=true
WORKDIR /repo
# Sem corepack: o corepack do node:22.12.0 não conhece as chaves atuais de assinatura do npm
# ("Cannot find matching keyid") e não consegue baixar o pnpm. Mesma versão do packageManager.
RUN npm install -g pnpm@9.15.9

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/server/package.json apps/server/
COPY packages/protocol/package.json packages/protocol/
COPY packages/rules/package.json packages/rules/
COPY apps/mobile/package.json apps/mobile/
COPY packages/ui/package.json packages/ui/
COPY packages/avatar/package.json packages/avatar/
RUN pnpm install --frozen-lockfile --filter @trucaco/server...

COPY apps/server apps/server
COPY packages/protocol packages/protocol
COPY packages/rules packages/rules
# Gera o Prisma Client (apps/server/src/generated, fora do git) ANTES do tsup/tsc: o bundle o embute.
# `prisma generate` não conecta ao banco e não precisa de DATABASE_URL. O turbo também encadeia
# `db:generate` antes do build; o passo explícito falha cedo se o schema estiver quebrado.
RUN pnpm --filter @trucaco/server db:generate
RUN pnpm turbo run build --filter=@trucaco/server
# `pnpm deploy` gera uma pasta autossuficiente (node_modules sem symlinks para a raiz do monorepo).
# Copiar só apps/server/node_modules quebraria com ERR_MODULE_NOT_FOUND. Os pacotes @trucaco/*
# ficam dentro do bundle tsup.
RUN pnpm --filter @trucaco/server deploy --prod /out

# ---- web: export estático do Expo, servido pelo servidor na mesma origem (WEB_DIST_DIR) ----
# Sem EXPO_PUBLIC_SERVER_URL o web de produção usa a origem da própria página (apps/mobile/src/net/config.ts),
# então a mesma imagem serve em qualquer domínio. Só passe --build-arg EXPO_PUBLIC_SERVER_URL para apontar o
# web para OUTRA origem (https em produção).
FROM ${NODE_IMAGE} AS web
ARG EXPO_PUBLIC_SERVER_URL
ENV CI=true
ENV EXPO_PUBLIC_SERVER_URL=${EXPO_PUBLIC_SERVER_URL}
# Sem NODE_ENV=production aqui: ele faria o pnpm install pular as devDependencies (tsc, expo).
WORKDIR /repo
RUN npm install -g pnpm@9.15.9

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/server/package.json apps/server/
COPY packages/protocol/package.json packages/protocol/
COPY packages/rules/package.json packages/rules/
COPY apps/mobile/package.json apps/mobile/
COPY packages/ui/package.json packages/ui/
COPY packages/avatar/package.json packages/avatar/
RUN pnpm install --frozen-lockfile --filter @trucaco/mobile...

COPY apps/mobile apps/mobile
COPY packages packages
# O Metro importa os áudios e o .riv da raiz (../../../assets); o .dockerignore só tira o que é fonte.
COPY assets assets
RUN pnpm --filter "@trucaco/mobile..." run build
# apps/mobile/dist = saída de `expo export --platform web`

# ---- migrate: CLI do Prisma isolado, só para o release_command (migrate deploy) ----
# O `prisma` é devDependency do server e não entra no `pnpm deploy --prod`. A versão é LIDA do
# apps/server/package.json (não diverge) e o build falha se não for exata. Limitação: `npm install` da
# versão exata do CLI, sem lockfile; as dependências transitivas dele podem variar entre builds.
FROM ${NODE_IMAGE} AS migrate
WORKDIR /migrate
COPY apps/server/package.json ./server-package.json
RUN V="$(node -p "require('./server-package.json').devDependencies.prisma")"  && case "$V" in [0-9]*.[0-9]*.[0-9]*) ;; *) echo "versão do prisma não é exata: $V" >&2; exit 1 ;; esac  && npm init -y >/dev/null && npm install --no-audit --no-fund "prisma@$V"
COPY apps/server/prisma.config.ts ./
COPY apps/server/prisma ./prisma

# Migrações NÃO rodam ao subir o servidor. O CLI fica em /app/migrate e roda só no release_command do Fly
# (com DATABASE_URL): cd /app/migrate && node node_modules/prisma/build/index.js migrate deploy
# ---- runtime ----
FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production \
    PORT=2567
WORKDIR /app
COPY --from=build --chown=node:node /out/node_modules ./node_modules
COPY --from=build --chown=node:node /repo/apps/server/dist ./dist
COPY --from=web --chown=node:node /repo/apps/mobile/dist ./web
COPY --from=migrate --chown=node:node /migrate ./migrate
USER node
EXPOSE 2567
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||2567)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
