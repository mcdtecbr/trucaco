{
  "name": "@trucaco/avatar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./audio": {
      "types": "./dist/audioManifest.d.ts",
      "default": "./dist/audioManifest.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@trucaco/protocol": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4"
  }
}
